# NodePilot systemd service — generated by scripts/install-service.sh
# Do not edit this file directly. Add overrides (e.g. a different PORT)
# with: sudo systemctl edit nodepilot

[Unit]
Description=NodePilot - Self-hosted Proxmox Infrastructure Dashboard
Documentation=https://github.com/Alexmen97/nodepilot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@@SERVICE_USER@@
Group=@@SERVICE_USER@@
WorkingDirectory=@@APP_DIR@@
ExecStart="@@NODE_BIN@@" "@@APP_DIR@@/server.js"
Restart=on-failure
RestartSec=5
Environment=PORT=@@PORT@@

# Conservative hardening, safe for the default setup:
NoNewPrivileges=true
PrivateTmp=true

# Optional stricter isolation — uncomment only after testing on your setup.
# ProtectHome requires ReadWritePaths for installations under /home.
#ProtectSystem=full
#ProtectHome=read-only
#ReadWritePaths=@@APP_DIR@@

[Install]
WantedBy=multi-user.target
